{
  "name": "wowaddons",
  "private": true,
  "version": "0.16.2",
  "packageManager": "bun@1.4.5",
  "type": "module",
  "scripts": {
    "test": "bun run test:unit && bun run test:sim",
    "test:unit": "cd addons/OneMoreQuest && luajit tests/run.lua",
    "test:sim": "addonsim test",
    "sim": "addonsim serve",
    "typecheck": "tsc --noEmit -p .",
    "lint": "bun run lint:ts && bun run lint:lua",
    "lint:ts": "biome check .",
    "format": "biome check --write . && bun run format:lua",
    "format:lua": "bun node_modules/addonsim/tools/lua-tools.ts format addons sim tools",
    "lint:lua": "bun node_modules/addonsim/tools/lua-tools.ts check addons sim tools",
    "luacheck:globals": "addonsim run sim/tools/luacheck-globals.lua",
    "zip": "bun tools/release/build-zip.ts",
    "site": "bun tools/site/build.ts",
    "site:preview": "bun tools/site/preview.ts",
    "media": "bun tools/site/media.ts",
    "release:notes": "bun tools/release/notes.ts",
    "release:version": "bun tools/release/version.ts",
    "release:dry-run": "bun run zip && bun tools/release/curseforge.ts --dry-run",
    "check": "bun run typecheck && bun run lint && bun run test:unit && bun run zip && bun run site"
  },
  "dependencies": {
    "addonsim": "link:addonsim"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "^1.4.5",
    "typescript": "7"
  }
}
